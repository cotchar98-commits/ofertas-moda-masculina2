  <style>
    :root {
      --black: #101010;
      --dark: #191919;
      --card: #202020;
      --white: #f7f7f5;
      --muted: #b5b5b5;
      --accent: #c6ff4d;
      --border: rgba(255,255,255,.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(ellipse at 50% 0%, #c6ff4d12, transparent 40%),
        var(--black);
      color: var(--white);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.5;
    }

    .container {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
      padding: 22px 17px 30px;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      margin-bottom: 23px;
      color: var(--white);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      background: var(--accent);
      color: var(--black);
      font-weight: 900;
      font-size: 16px;
      transform: skew(-7deg);
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 29px 21px 24px;
      border: 1px solid var(--border);
      border-radius: 22px;
      background: linear-gradient(145deg, #242424, #151515 72%);
      box-shadow: 0 22px 65px #0008;
    }

    .tag {
      display: inline-block;
      padding: 7px 11px;
      border: 1px solid #c6ff4d66;
      border-radius: 4px;
      background: #c6ff4d10;
      color: var(--accent);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.3px;
      text-transform: uppercase;
    }

    h1 {
      margin-top: 22px;
      font-size: clamp(38px, 10vw, 53px);
      line-height: .99;
      font-weight: 950;
      letter-spacing: -2.5px;
      text-transform: uppercase;
    }

    h1 span {
      color: var(--accent);
    }

    .subtitle {
      margin-top: 18px;
      color: #d0d0d0;
      font-size: 15px;
      line-height: 1.7;
    }

    .subtitle strong {
      color: var(--white);
    }

    .visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 24px 0;
      padding: 19px 16px;
      min-height: 112px;
      overflow: hidden;
      border-radius: 13px;
      background:
        linear-gradient(105deg, #c6ff4d18, transparent 72%),
        #111;
      border: 1px solid #ffffff12;
    }

    .visual::after {
      content: "STYLE";
      position: absolute;
      right: -5px;
      bottom: -20px;
      color: #ffffff08;
      font-size: 70px;
      font-weight: 950;
      letter-spacing: -5px;
      pointer-events: none;
    }

    .visual-label {
      position: relative;
      z-index: 1;
      max-width: 230px;
    }

    .visual-label small {
      display: block;
      margin-bottom: 6px;
      color: var(--accent);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.5px;
    }

    .visual-label strong {
      display: block;
      font-size: 20px;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .visual-icon {
      position: relative;
      z-index: 1;
      font-size: 42px;
    }

    .section-title {
      margin: 23px 0 13px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .benefits {
      display: grid;
      gap: 10px;
      margin-bottom: 24px;
    }

    .benefit {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #ffffff04;
      color: #e4e4e4;
      font-size: 13px;
    }

    .check {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 25px;
      height: 25px;
      border-radius: 6px;
      background: #c6ff4d17;
      color: var(--accent);
      font-weight: 900;
    }

    .cta-area {
      display: grid;
      gap: 12px;
    }

    .cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      min-height: 59px;
      padding: 15px 12px;
      border: 1px solid var(--accent);
      border-radius: 9px;
      background: var(--accent);
      color: #111;
      text-align: center;
      text-decoration: none;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: .3px;
      transition: transform .15s, filter .15s;
    }

    .cta:hover {
      filter: brightness(1.06);
      transform: translateY(-2px);
    }

    .cta:active {
      transform: scale(.98);
    }

    .cta svg {
      flex-shrink: 0;
      width: 22px;
      height: 22px;
    }

    .cta.secondary {
      border-color: #ffffff28;
      background: #ffffff08;
      color: var(--white);
    }

    .cta.secondary:hover {
      border-color: var(--accent);
    }

    .cta.secondary .arrow {
      color: var(--accent);
    }

    .timer {
      margin-top: 21px;
      color: var(--muted);
      text-align: center;
      font-size: 12px;
    }

    .timer strong {
      color: var(--accent);
      font-size: 14px;
    }

    .progress {
      height: 4px;
      margin-top: 11px;
      overflow: hidden;
      border-radius: 10px;
      background: #ffffff18;
    }

    .progress-bar {
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: var(--accent);
      transform-origin: left;
      animation: countdown 20s linear forwards;
    }

    @keyframes countdown {
      to { transform: scaleX(0); }
    }

    .trust {
      margin-top: 18px;
      color: #858585;
      text-align: center;
      font-size: 10px;
      line-height: 1.7;
    }

    .footer {
